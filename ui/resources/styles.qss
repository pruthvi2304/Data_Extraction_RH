QWidget {
    background-color: #0f1722;
    color: #f5f7fb;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow {
    background-color: #0b111a;
}

#dashboardCard,
#metricsCard,
#natsStatusCard,
#chartCard {
    background-color: #162131;
    border: 1px solid #233247;
    border-radius: 14px;
}

#cardTitle {
    font-size: 13pt;
    font-weight: 700;
    color: #ffffff;
}

#alertBanner {
    padding: 10px 14px;
    background-color: #1c2b3d;
    border: 1px solid #29405b;
    border-radius: 10px;
    color: #d7e3f4;
}

QToolButton#controllerCard {
    background-color: #1b2a3d;
    border: 2px solid #3b526d;
    border-radius: 12px;
    color: #f5f7fb;
    padding: 12px;
    text-align: center;
}

QToolButton#controllerCard:hover {
    background-color: #243b55;
    border-color: #71c7ff;
}

QToolButton#controllerCard:pressed {
    background-color: #2c4d6e;
    border-color: #a4ddff;
}

QToolButton#controllerCard:focus {
    border-color: #71c7ff;
}

QToolButton#controllerCard QLabel {
    background: transparent;
    color: #f5f7fb;
}

#controllerCardTitle {
    font-size: 12pt;
    font-weight: 700;
}

QLineEdit,
QTableView,
QHeaderView::section,
QPushButton {
    border-radius: 8px;
}

QLineEdit {
    background-color: #111c2b;
    border: 1px solid #2e445f;
    padding: 8px 10px;
}

QPushButton {
    background-color: #27496d;
    border: 1px solid #325c88;
    padding: 8px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2f5a86;
}

QTableView {
    background-color: #101926;
    alternate-background-color: #132033;
    border: 1px solid #2b3d53;
    gridline-color: #2b3d53;
    selection-background-color: #28527a;
}

QHeaderView::section {
    background-color: #172434;
    border: none;
    padding: 8px;
    color: #b6c5d6;
    font-weight: 700;
}

QLabel {
    background: transparent;
}

QStatusBar {
    background-color: #111927;
    color: #d9e4f2;
}
